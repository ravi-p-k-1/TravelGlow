{
  "name": "travelglow-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/database/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/domain/environmentComparison.test.ts src/domain/skin-engine/travelSkinEngine.test.ts src/domain/packing-list/packingListGenerator.test.ts src/services/geminiService.test.ts src/utils/imageDimensions.test.ts"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "multer": "2.2.0",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
